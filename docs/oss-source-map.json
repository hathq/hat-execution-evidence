{
  "repository": "hathq/hat-execution-evidence",
  "purpose": "Record an admitted HAT execution result with exact references that other components can verify.",
  "responsibility_boundary": "This HAT role owns its declared product invocation and exact capability/scope binding. Shared transport, document handling and authorization primitives use their managed owners. A role declaration alone is not evidence of an implemented external action.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "hat-execution-evidence",
      "ecosystem": "rust",
      "description": "Provider-owned durable HAT execution attestation and read-only evidence lookup",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {
          "transport": [
            "dep:crowsi-transport-foundation",
            "dep:tokio",
            "zixcel-revision/redb"
          ]
        },
        "bins": [
          {
            "name": "hat-evidence-lookup",
            "path": "src/bin/lookup.rs",
            "required-features": [
              "transport"
            ]
          },
          {
            "name": "hat-evidence-authority",
            "path": "src/bin/authority.rs",
            "required-features": [
              "transport"
            ]
          }
        ],
        "public_modules": [
          "transport"
        ],
        "public_reexports": [],
        "implicit_bins": [
          "src/bin/authority.rs",
          "src/bin/lookup.rs"
        ]
      },
      "declared_commands": {}
    }
  ],
  "schema_definitions": [],
  "test_sources": [
    "src/bin/authority.rs",
    "src/bin/lookup.rs",
    "src/lib.rs",
    "src/transport.rs",
    "tests/authority.rs"
  ],
  "example_sources": [],
  "workflow_definitions": [
